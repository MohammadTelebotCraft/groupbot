+    fn peer_bound_keeps_chats_and_drops_only_the_oldest_users() {
+        tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap()
+            .block_on(do_peer_bound_keeps_chats_and_drops_only_the_oldest_users());
+    }
+
+    /// Losing a channel's access hash loses the ability to reach the chat, and no update ever
+    /// re-teaches it; a user is re-learned from the next message carrying them. So the bound
+    /// has to tell them apart, and it has to drop the least recently written users first.
+    async fn do_peer_bound_keeps_chats_and_drops_only_the_oldest_users() {
+        let path = std::env::temp_dir().join("grammers-peer-bound-test.session");
+        let _ = std::fs::remove_file(&path);
+        let session = SqliteSession::open(&path).await.unwrap();
+
+        {
+            let db = session.database.lock().await;
+            for (id, seen) in [
+                (-1001_i64, 1_i64),
+                (-1002, 2),
+                (10, 5),
+                (11, 10),
+                (12, 15),
+                (13, 20),
+            ] {
+                db.0.execute(
+                    "INSERT OR REPLACE INTO peer_info (peer_id, hash, subtype, seen) \
+                     VALUES (:peer_id, 7, NULL, :seen)",
+                    named_params! {":peer_id": id, ":seen": seen},
+                )
+                .await
+                .unwrap();
+            }
+
+            db.bound_peers_to(2).await;
+
+            let ids: Vec<i64> = db
+                .fetch_all("SELECT peer_id FROM peer_info", named_params![], |row| {
+                    Ok(row.get::<i64>(0)?)
+                })
+                .await
+                .unwrap();
+
+            assert!(ids.contains(&-1001), "a channel is never dropped");
+            assert!(ids.contains(&-1002), "a channel is never dropped");
+            assert!(ids.contains(&13), "the newest user stays");
+            assert!(ids.contains(&12), "the second newest user stays");
+            assert!(!ids.contains(&11), "an older user goes");
+            assert!(!ids.contains(&10), "the oldest user goes");
+        }
+
+        let _ = std::fs::remove_file(&path);
+    }
