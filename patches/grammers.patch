+/// Result of asking Telegram to deliver a login code.
+#[derive(Debug)]
+#[non_exhaustive]
+pub enum LoginCode {
+    /// A code was sent and this token is needed to submit it with [`Client::sign_in`].
+    Sent(LoginToken),
+    /// Telegram authorized the session without requiring a separate code submission.
+    Authorized(Box<User>),
