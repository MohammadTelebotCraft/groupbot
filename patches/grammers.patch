+#[derive(Debug, Eq, PartialEq)]
+enum ForwardUpdate {
+    Forwarded,
+    Dropped,
+    Closed,
+}
+
+struct UpdateForwarder {
+    updates: mpsc::Sender<UpdatesLike>,
+    policy: crate::UpdatesOverflowPolicy,
+    recovery_scope: Arc<RecoveryScope>,
+    /// Serializes the two-slot normal admission and one-slot recovery admission protocol across
+    /// all datacenter sender tasks. The guard is never held across an await.
+    forwarding: Mutex<()>,
+}
+
+impl UpdateForwarder {
+    fn configured_capacity(&self) -> usize {
+        self.updates.max_capacity().saturating_sub(usize::from(
+            self.policy == crate::UpdatesOverflowPolicy::RecoverGap,
+        ))
+    }
+
+    fn forward(&self, update: UpdatesLike) -> ForwardUpdate {
+        match self.policy {
+            crate::UpdatesOverflowPolicy::DropNewest => match self.updates.try_send(update) {
+                Ok(()) => ForwardUpdate::Forwarded,
+                Err(mpsc::error::TrySendError::Full(_)) => ForwardUpdate::Dropped,
+                Err(mpsc::error::TrySendError::Closed(_)) => ForwardUpdate::Closed,
+            },
+            crate::UpdatesOverflowPolicy::RecoverGap => {
+                {
+                    let _guard = self
+                        .forwarding
+                        .lock()
+                        .unwrap_or_else(|error| error.into_inner());
+                    match self.updates.try_reserve_many(2) {
+                        Ok(mut permits) => match permits.next() {
+                            Some(permit) => {
+                                permit.send(update);
+                                return ForwardUpdate::Forwarded;
+                            }
+                            None => return ForwardUpdate::Closed,
+                        },
+                        Err(mpsc::error::TrySendError::Full(())) => {}
+                        Err(mpsc::error::TrySendError::Closed(())) => {
+                            return ForwardUpdate::Closed;
+                        }
+                    }
+                }
+
+                // Mapping a potentially large envelope is deliberately outside the forwarding
+                // lock. The shared scope provides its own short state lock.
+                self.recovery_scope.record(&update);
+                let _guard = self
+                    .forwarding
+                    .lock()
+                    .unwrap_or_else(|error| error.into_inner());
+                if !self.recovery_scope.claim_marker() {
+                    return ForwardUpdate::Dropped;
+                }
+                match self
+                    .updates
+                    .try_send(UpdatesLike::RecoveryNeeded(Arc::clone(
+                        &self.recovery_scope,
+                    ))) {
+                    Ok(()) => ForwardUpdate::Dropped,
+                    Err(mpsc::error::TrySendError::Full(_)) => {
+                        self.recovery_scope.cancel_marker();
+                        ForwardUpdate::Dropped
+                    }
+                    Err(mpsc::error::TrySendError::Closed(_)) => {
+                        self.recovery_scope.cancel_marker();
+                        ForwardUpdate::Closed
+                    }
+                }
+            }
+        }
+    }
+}
