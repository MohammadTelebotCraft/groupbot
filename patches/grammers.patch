+    /// One step of signing in by QR code, the way the mobile apps scan a desktop login.
+    ///
+    /// Call it in a loop: while it returns [`QrLogin::Waiting`], show the token as a QR code
+    /// and call again a second or two later (the token is re-exported once it expires).
+    ///
+    /// Telegram only ever tells us "not yet" by handing back a token again, so polling is
+    /// the whole protocol; there is nothing to wait on.
+    pub async fn qr_login_step(&self, api_hash: &str) -> Result<QrLogin, InvocationError> {
+        let request = tl::functions::auth::ExportLoginToken {
+            api_id: self.0.api_id,
+            api_hash: api_hash.to_string(),
+            except_ids: Vec::new(),
+        };
+        let result = match self.invoke(&request).await {
+            Ok(result) => result,
+            Err(InvocationError::Rpc(err)) if err.name.contains("SESSION_PASSWORD_NEEDED") => {
+                return Ok(QrLogin::PasswordRequired(
+                    self.get_password_information().await?,
+                ));
+            }
+            Err(err) => return Err(err),
+        };
+        self.qr_login_result(result).await
+    }
+
+    async fn qr_login_result(
+        &self,
+        result: tl::enums::auth::LoginToken,
+    ) -> Result<QrLogin, InvocationError> {
+        match result {
+            tl::enums::auth::LoginToken::Token(token) => Ok(QrLogin::Waiting {
+                token: token.token,
+                expires: token.expires,
+            }),
+            // The account lives in another data centre: move there and hand the token over.
+            tl::enums::auth::LoginToken::MigrateTo(migrate) => {
+                let old_dc_id = self.0.session.home_dc_id()?;
+                self.0.handle.disconnect_from_dc(old_dc_id);
+                self.0.session.set_home_dc_id(migrate.dc_id).await?;
+                let imported = self
+                    .invoke(&tl::functions::auth::ImportLoginToken {
+                        token: migrate.token,
+                    })
+                    .await?;
+                Box::pin(self.qr_login_result(imported)).await
+            }
+            tl::enums::auth::LoginToken::Success(success) => match success.authorization {
+                tl::enums::auth::Authorization::Authorization(auth) => {
+                    Ok(QrLogin::Success(self.complete_login(auth).await?))
+                }
+                tl::enums::auth::Authorization::SignUpRequired(_) => {
+                    Err(InvocationError::Dropped)
+                }
+            },
+        }
+    }
