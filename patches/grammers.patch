+#[test]
+fn test_gapped_channel_is_never_dropped_as_idle() {
+    reset_time();
+    let mut message_boxes = MessageBoxes::new();
+    message_boxes.set_drop_idle_channels(true);
+    message_boxes.set_state(state(1, 1, 34, 34));
+    let channel_id = 12;
+    message_boxes.try_set_channel_state(channel_id, 34);
+
+    // An update that skips ahead is held back, waiting for the one in between.
+    assert_eq!(
+        message_boxes.process_updates(channel_updates(channel_id, NO_DATE, NO_SEQ, 37)),
+        Ok((Vec::new(), Vec::new(), Vec::new()))
+    );
+
+    // A gapped entry's effective deadline is the gap's own — half a second, not fifteen
+    // minutes. Dropping on that would throw the held update away and skip the difference
+    // that recovers what is missing, which is a command the user sent going unanswered.
+    advance_time_by(POSSIBLE_GAP_TIMEOUT * 2);
+    message_boxes.check_deadlines();
+    assert!(
+        message_boxes.get_channel_difference().is_some(),
+        "a gapped channel has to resolve its difference, not be forgotten"
+    );
+    assert_eq!(
+        message_boxes.session_state().channels,
+        vec![ChannelState {
+            id: channel_id,
+            pts: 34
+        }],
+        "the entry has to still be there"
+    );
+}
