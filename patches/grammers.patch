+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn checked_chunk_offset_rejects_negative_and_overflowing_skips() {
+        assert_eq!(checked_chunk_offset(10, MIN_CHUNK_SIZE, 2).unwrap(), 8_202);
+        assert_eq!(
+            checked_chunk_offset(0, MIN_CHUNK_SIZE, -1)
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidInput
+        );
+        assert_eq!(
+            checked_chunk_offset(i64::MAX, MAX_CHUNK_SIZE, 1)
+                .unwrap_err()
+                .kind(),
+            io::ErrorKind::InvalidInput
+        );
+        assert_eq!(
+            checked_chunk_offset(0, MAX_CHUNK_SIZE, i32::MAX).unwrap(),
+            i64::from(MAX_CHUNK_SIZE) * i64::from(i32::MAX)
+        );
+    }
+
+    #[cfg(feature = "fs")]
+    #[test]
+    fn concurrent_range_math_rejects_multiplication_and_addition_overflow() {
+        assert_eq!(
+            concurrent_chunk_offset(2).unwrap(),
+            2 * i64::from(MAX_CHUNK_SIZE)
+        );
+        assert_eq!(
+            concurrent_chunk_offset(usize::MAX).unwrap_err().kind(),
+            io::ErrorKind::InvalidInput
+        );
+        assert_eq!(
+            checked_received_end(u64::MAX, 1).unwrap_err().kind(),
+            io::ErrorKind::InvalidData
+        );
+    }
+}
