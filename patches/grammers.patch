+
+/// A serialized function body starts with the function's own constructor identifier, but the
+/// generated `deserialize` starts reading fields immediately. Parsing a request body without
+/// skipping those four bytes therefore fails, which once made `channels.deleteMessages`
+/// responses apply a channel pts to the common sequence and gap it permanently.
+#[test]
+fn function_body_needs_its_constructor_id_skipped() {
+    use grammers_tl_types::{Deserializable, Identifiable, Serializable, enums, functions, types};
+
+    let request = functions::channels::DeleteMessages {
+        channel: enums::InputChannel::Channel(types::InputChannel {
+            channel_id: 1234,
+            access_hash: 5678,
+        }),
+        id: vec![42],
+    };
+    let body = request.to_bytes();
+
+    assert!(
+        functions::channels::DeleteMessages::from_bytes(&body).is_err(),
+        "if functions ever start consuming their own id, drop the strip_prefix in sender.rs"
+    );
+
+    let rest = body
+        .strip_prefix(&functions::channels::DeleteMessages::CONSTRUCTOR_ID.to_le_bytes())
+        .expect("body must begin with the function's constructor id");
+    let parsed = functions::channels::DeleteMessages::from_bytes(rest).unwrap();
+    assert!(matches!(
+        parsed.channel,
+        enums::InputChannel::Channel(types::InputChannel { channel_id: 1234, .. })
+    ));
+    assert_eq!(parsed.id, vec![42]);
+}
