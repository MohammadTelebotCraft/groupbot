+#[test]
+fn drop_idle_skips_only_the_initial_channel_catch_up_scan() {
+    reset_time();
+    let mut message_boxes = MessageBoxes::load(UpdatesState {
+        pts: 12,
+        qts: 34,
+        date: 56,
+        seq: 78,
+        channels: vec![ChannelState { id: 43, pts: 21 }],
+    });
+    message_boxes.set_drop_idle_channels(true);
+
+    assert_eq!(
+        message_boxes.get_difference(),
+        Some(get_difference(56, 12, 34)),
+        "common and secondary state must still catch up"
+    );
+    assert_eq!(message_boxes.get_channel_difference(), None);
+    assert_eq!(
+        message_boxes.session_state().channels,
+        vec![ChannelState { id: 43, pts: 21 }],
+        "skipping the eager scan must retain the channel checkpoint"
+    );
+
+    assert!(
+        message_boxes
+            .try_apply_difference(tl::types::updates::DifferenceEmpty { date: 56, seq: 78 }.into())
+            .is_ok()
+    );
+    assert_eq!(
+        message_boxes.process_updates(channel_updates(43, NO_DATE, NO_SEQ, 23)),
+        Ok((Vec::new(), Vec::new(), Vec::new()))
+    );
+    advance_time_by(POSSIBLE_GAP_TIMEOUT * 2);
+    message_boxes.check_deadlines();
+    assert_eq!(
+        message_boxes.get_channel_difference(),
+        Some(get_channel_difference(43, 21)),
+        "the next real channel gap must recover from the persisted checkpoint"
+    );
+
+    // Re-applying the policy later must never erase a genuine queued gap.
+    message_boxes.set_drop_idle_channels(true);
+    assert_eq!(
+        message_boxes.get_channel_difference(),
+        Some(get_channel_difference(43, 21))
+    );
+}
