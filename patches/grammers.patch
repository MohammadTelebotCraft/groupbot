index 0000000..638dc9f
--- /dev/null
+++ b/grammers-client/src/client/outbound.rs
@@ -0,0 +1,528 @@
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::{Duration, Instant};
+
+use grammers_session::types::PeerRef;
+use tokio::sync::{Mutex, OwnedSemaphorePermit, Semaphore};
+
+const DEFAULT_RATE: u32 = 25;
+const DEFAULT_CONCURRENCY: usize = 32;
+const DEFAULT_CRITICAL_RESERVED_CONCURRENCY: usize = 8;
+const DEFAULT_GROUP_MESSAGES_PER_MINUTE: u32 = 20;
+const DEFAULT_CHAT_CACHE_MAX: usize = 50_000;
+
+struct Bucket {
+    tokens: f64,
+    updated: Instant,
+}
+
+/// Shared backpressure for account-level Telegram writes.
+///
+/// A `Client` is cloneable, and every `Message` created by it keeps a clone too. Keeping this
+/// budget in `ClientInner` therefore makes replies, scheduled jobs, and detached moderation work
+/// share one account-wide queue instead of each path creating its own burst. Reads still use the
+/// normal `invoke` path; only callers that explicitly use `invoke_outbound` consume this budget.
+pub(crate) struct OutboundBudget {
+    bucket: Mutex<Bucket>,
+    rate: f64,
+    burst: f64,
+    in_flight: Arc<Semaphore>,
+    /// Ordinary sends/edits may use only this subset. Enforcement skips it and can therefore
+    /// always reach the account limiter even when a notification burst occupies every ordinary
+    /// slot. The shared `in_flight` semaphore still caps the aggregate number of Telegram RPCs.
+    ordinary_in_flight: Arc<Semaphore>,
+    critical_reserved: usize,
+    active: Arc<AtomicUsize>,
+    waiting: AtomicUsize,
+    critical_waiting: AtomicUsize,
+    chat_waiting: AtomicUsize,
+    /// Telegram's group message ceiling is per peer, not just per account. The map is capped so
+    /// a fleet of quiet groups cannot turn pacing metadata into another process-wide leak.
+    chat_next: Mutex<HashMap<i64, Instant>>,
+    chat_interval: Duration,
+    chat_cache_max: usize,
+}
+
+pub(crate) struct OutboundPermit {
+    _in_flight: OwnedSemaphorePermit,
+    _ordinary: Option<OwnedSemaphorePermit>,
+    active: Arc<AtomicUsize>,
+}
+
+impl Drop for OutboundPermit {
+    fn drop(&mut self) {
+        self.active.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+impl OutboundBudget {
+    pub(crate) fn from_env() -> Self {
+        let rate = env_u32("TELEGRAM_ACTIONS_PER_SECOND", DEFAULT_RATE, 1, 1_000);
+        let burst = env_u32("TELEGRAM_ACTION_BURST", rate, 1, 10_000);
+        let concurrency = env_usize(
+            "TELEGRAM_OUTBOUND_CONCURRENCY",
+            DEFAULT_CONCURRENCY,
+            1,
+            1_024,
+        );
+        let critical_reserved = env_usize(
+            "TELEGRAM_CRITICAL_RESERVED_CONCURRENCY",
+            DEFAULT_CRITICAL_RESERVED_CONCURRENCY,
+            1,
+            1_024,
+        )
+        .min(concurrency.saturating_sub(1));
+        let group_messages = env_u32(
+            "TELEGRAM_GROUP_MESSAGES_PER_MINUTE",
+            DEFAULT_GROUP_MESSAGES_PER_MINUTE,
+            1,
+            1_200,
+        );
+        let chat_cache_max = env_usize(
+            "TELEGRAM_CHAT_RATE_CACHE_MAX",
+            DEFAULT_CHAT_CACHE_MAX,
+            1_000,
+            500_000,
+        );
+        Self {
+            bucket: Mutex::new(Bucket {
+                tokens: burst as f64,
+                updated: Instant::now(),
+            }),
+            rate: rate as f64,
+            burst: burst as f64,
+            in_flight: Arc::new(Semaphore::new(concurrency)),
+            ordinary_in_flight: Arc::new(Semaphore::new(concurrency - critical_reserved)),
+            critical_reserved,
+            active: Arc::new(AtomicUsize::new(0)),
+            waiting: AtomicUsize::new(0),
+            critical_waiting: AtomicUsize::new(0),
+            chat_waiting: AtomicUsize::new(0),
+            chat_next: Mutex::new(HashMap::new()),
+            chat_interval: Duration::from_secs_f64(60.0 / group_messages as f64),
+            chat_cache_max,
+        }
+    }
+
+    /// Reserve a per-group message slot before taking the account-wide permit. Waiting here,
+    /// rather than while holding one of the 32 account slots, keeps a noisy group from starving
+    /// unrelated groups on the same bot account.
+    pub(crate) async fn acquire_for_peer(&self, peer: PeerRef) -> OutboundPermit {
+        if let Some(chat) = peer.id.bot_api_dialog_id().filter(|chat| *chat < 0) {
+            let delay = {
+                let now = Instant::now();
+                let mut next = self.chat_next.lock().await;
+                reserve_chat(
+                    &mut next,
+                    chat,
+                    now,
+                    self.chat_interval,
+                    self.chat_cache_max,
+                )
+            };
+            if !delay.is_zero() {
+                self.chat_waiting.fetch_add(1, Ordering::Relaxed);
+                let _waiting = ChatWaitingGuard(&self.chat_waiting);
+                tokio::time::sleep(delay).await;
+            }
+        }
+        self.acquire().await
+    }
+
+    pub(crate) async fn acquire(&self) -> OutboundPermit {
+        self.waiting.fetch_add(1, Ordering::Relaxed);
+        let _waiting = ChatWaitingGuard(&self.waiting);
+        let ordinary = Arc::clone(&self.ordinary_in_flight)
+            .acquire_owned()
+            .await
+            .expect("the ordinary outbound semaphore is never closed");
+        let in_flight = Arc::clone(&self.in_flight)
+            .acquire_owned()
+            .await
+            .expect("the outbound semaphore is never closed");
+
+        loop {
+            let delay = {
+                let mut bucket = self.bucket.lock().await;
+                let elapsed = bucket.updated.elapsed().as_secs_f64();
+                bucket.updated = Instant::now();
+                bucket.tokens = (bucket.tokens + elapsed * self.rate).min(self.burst);
+                if bucket.tokens >= 1.0 && self.critical_waiting.load(Ordering::Acquire) == 0 {
+                    bucket.tokens -= 1.0;
+                    None
+                } else if bucket.tokens >= 1.0 {
+                    // A critical caller has already joined one of its reserved concurrency
+                    // slots. Leave the available token for it; the short sleep is bounded by
+                    // the configured token interval and avoids a busy loop.
+                    Some(Duration::from_secs_f64(1.0 / self.rate))
+                } else {
+                    Some(Duration::from_secs_f64((1.0 - bucket.tokens) / self.rate))
+                }
+            };
+            let Some(delay) = delay else { break };
+            tokio::time::sleep(delay).await;
+        }
+
+        self.active.fetch_add(1, Ordering::Relaxed);
+        OutboundPermit {
+            _in_flight: in_flight,
+            _ordinary: Some(ordinary),
+            active: Arc::clone(&self.active),
+        }
+    }
+
+    /// Admit correctness-critical moderation without waiting behind the ordinary concurrency
+    /// partition. This does not bypass the account token bucket: critical and ordinary calls
+    /// still share the same configured request rate and burst, so prioritisation cannot create a
+    /// Telegram flood. At concurrency one no reservation is possible and behaviour is unchanged.
+    pub(crate) async fn acquire_critical(&self) -> OutboundPermit {
+        // With a real reservation this early count makes ordinary token waiters yield before the
+        // critical task is polled again. At total concurrency one there is no reserved slot, so
+        // count only after taking the shared permit; otherwise the sole ordinary holder could
+        // yield its token to a critical task that cannot enter, deadlocking both classes.
+        let counted_early = self.critical_reserved != 0;
+        let mut waiting_guard = if counted_early {
+            self.critical_waiting.fetch_add(1, Ordering::Relaxed);
+            Some(ChatWaitingGuard(&self.critical_waiting))
+        } else {
+            None
+        };
+        let in_flight = Arc::clone(&self.in_flight)
+            .acquire_owned()
+            .await
+            .expect("the outbound semaphore is never closed");
+        if !counted_early {
+            self.critical_waiting.fetch_add(1, Ordering::Relaxed);
+            waiting_guard = Some(ChatWaitingGuard(&self.critical_waiting));
+        }
+        let _waiting = waiting_guard;
+
+        loop {
+            let delay = {
+                let mut bucket = self.bucket.lock().await;
+                let elapsed = bucket.updated.elapsed().as_secs_f64();
+                bucket.updated = Instant::now();
+                bucket.tokens = (bucket.tokens + elapsed * self.rate).min(self.burst);
+                if bucket.tokens >= 1.0 {
+                    bucket.tokens -= 1.0;
+                    None
+                } else {
+                    Some(Duration::from_secs_f64((1.0 - bucket.tokens) / self.rate))
+                }
+            };
+            let Some(delay) = delay else { break };
+            tokio::time::sleep(delay).await;
+        }
+
+        self.active.fetch_add(1, Ordering::Relaxed);
+        OutboundPermit {
+            _in_flight: in_flight,
+            _ordinary: None,
+            active: Arc::clone(&self.active),
+        }
+    }
+
+    pub(crate) fn snapshot(&self) -> (usize, usize) {
+        let active = self.active.load(Ordering::Relaxed);
+        let total = self.waiting.load(Ordering::Relaxed)
+            + self.critical_waiting.load(Ordering::Relaxed)
+            + self.chat_waiting.load(Ordering::Relaxed);
+        (active, total)
+    }
+
+    pub(crate) fn critical_waiting(&self) -> usize {
+        self.critical_waiting.load(Ordering::Relaxed)
+    }
+}
+
+struct ChatWaitingGuard<'a>(&'a AtomicUsize);
+
+impl Drop for ChatWaitingGuard<'_> {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::Relaxed);
+    }
+}
+
+fn reserve_chat(
+    next: &mut HashMap<i64, Instant>,
+    chat: i64,
+    now: Instant,
+    interval: Duration,
+    capacity: usize,
+) -> Duration {
+    if !next.contains_key(&chat) && next.len() >= capacity {
+        next.retain(|_, due| *due <= now);
+        while next.len() >= capacity {
+            let Some(oldest) = next
+                .iter()
+                .min_by_key(|(_, due)| **due)
+                .map(|(chat, _)| *chat)
+            else {
+                break;
+            };
+            next.remove(&oldest);
+        }
+    }
+    let due = next.entry(chat).or_insert(now);
+    let start = (*due).max(now);
+    *due = start + interval;
+    start.saturating_duration_since(now)
+}
+
+fn env_u32(name: &str, default: u32, min: u32, max: u32) -> u32 {
+    std::env::var(name)
+        .ok()
+        .and_then(|value| value.parse::<u32>().ok())
+        .unwrap_or(default)
+        .clamp(min, max)
+}
+
+fn env_usize(name: &str, default: usize, min: usize, max: usize) -> usize {
+    std::env::var(name)
+        .ok()
+        .and_then(|value| value.parse::<usize>().ok())
+        .unwrap_or(default)
+        .clamp(min, max)
+}
