+
+    /// Elision is what makes the cache worth having, and also the one way it could lose
+    /// information: skipping the write when the merge really did learn something new.
+    async fn do_peer_cache_merges_and_survives_eviction() {
+        let session = SqliteSession::open(":memory:").await.unwrap();
+        let id = 4_242;
+
+        // First half of what is known about this user: it is a bot, but with no hash yet.
+        session
+            .cache_peer(&PeerInfo::User {
+                id,
+                auth: None,
+                bot: Some(true),
+                is_self: None,
+            })
+            .await
+            .unwrap();
+
+        // Second half, from a different update: the hash, and nothing about being a bot.
+        session
+            .cache_peer(&PeerInfo::User {
+                id,
+                auth: Some(PeerAuth::from_hash(99)),
+                bot: None,
+                is_self: None,
+            })
+            .await
+            .unwrap();
+
+        let peer = PeerId::user(id).unwrap();
+        let known = session.peer(peer).await.unwrap().unwrap();
+        assert_eq!(
+            known,
+            PeerInfo::User {
+                id,
+                auth: Some(PeerAuth::from_hash(99)),
+                bot: Some(true),
+                is_self: Some(false),
+            },
+            "both halves have to survive the merge"
+        );
+
+        // Re-caching what is already known has to be free — it is every message after the first
+        // for this peer. A write forgets the key, so the entry still being there is the proof
+        // that no write happened.
+        assert!(session.peers.lock().unwrap().get(id).is_some());
+        session.cache_peer(&known).await.unwrap();
+        assert!(
+            session.peers.lock().unwrap().get(id).is_some(),
+            "re-caching a fully known peer must not touch the database"
+        );
+        assert_eq!(session.peer(peer).await.unwrap().unwrap(), known);
+
+        // Past the cap the entry is evicted from both generations, and the answer is still
+        // right because the database is the authority and a miss just costs one query.
+        for other in 0..(PeerCache::CAP as i64 * 2 + 1) {
+            session.peers.lock().unwrap().put(id + 1 + other, known.clone());
+        }
+        {
+            let mut cache = session.peers.lock().unwrap();
+            assert!(cache.get(id).is_none(), "the entry is gone from memory");
+        }
+        assert_eq!(
+            session.peer(peer).await.unwrap().unwrap(),
+            known,
+            "and it comes back off disk"
+        );
+    }
