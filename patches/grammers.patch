+        assert_eq!(payment.premium_days(), 7);
+        assert_eq!(payment.currency(), "USD");
+        assert_eq!(payment.amount(), 499);
+    }
+
+    #[test]
+    fn missing_and_unknown_password_algorithms_are_typed_errors() {
+        assert_eq!(
