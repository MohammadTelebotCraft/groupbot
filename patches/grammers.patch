+const SELF_PEER_KEY: i64 = i64::MIN;
+
+/// An in-memory cache in front of `peer_info`.
+///
+/// Every update batch carries the sender and the chat, and both are handed to `cache_peer` on
+/// the one task that reads updates — a `SELECT` and an `INSERT OR REPLACE` each, serialised on
+/// the database mutex, per message. Almost all of that is re-learning what is already known.
+///
+/// What makes the cache safe rather than merely fast is that [`PeerInfo::extend_info`] is
+/// monotone: it fills in fields it does not already hold and never overwrites one. The database
+/// merges the same way, so anything cached is what a read would have returned — every entry
+/// here came off disk, and a write forgets its key rather than guessing the normalised form
+/// the row will read back as.
+///
+/// Two generations rather than a real LRU. Inserts land in `hot`; when it fills, it becomes
+/// `cold` wholesale and a fresh `hot` starts, so the memory is bounded at twice the cap and a
+/// still-used entry is promoted back on its next hit.
+// ponytail: this is not the `clear()` anti-pattern — every row is still on disk, so a dropped
+// entry costs one `SELECT` and never data. Swap in a real LRU only if that refill measures.
+#[derive(Default)]
+struct PeerCache {
+    hot: HashMap<i64, PeerInfo>,
+    cold: HashMap<i64, PeerInfo>,
+}
+
+impl PeerCache {
+    /// About ten megabytes at the size a `PeerInfo` entry costs, doubled by the cold half.
+    const CAP: usize = 100_000;
+
+    fn get(&mut self, key: i64) -> Option<PeerInfo> {
+        if let Some(peer) = self.hot.get(&key) {
+            return Some(peer.clone());
+        }
+        let promoted = self.cold.remove(&key)?;
+        self.put(key, promoted.clone());
+        Some(promoted)
+    }
+
+    fn put(&mut self, key: i64, peer: PeerInfo) {
+        if self.hot.len() >= Self::CAP && !self.hot.contains_key(&key) {
+            self.cold = std::mem::take(&mut self.hot);
+        }
+        self.hot.insert(key, peer);
+    }
+
+    fn forget(&mut self, key: i64) {
+        self.hot.remove(&key);
+        self.cold.remove(&key);
+    }
+}
