+#[cfg(test)]
+mod tests {
+    use super::reserve_chat;
+    use std::collections::HashMap;
+    use std::time::{Duration, Instant};
+
+    fn test_budget(rate: u32, burst: u32, concurrency: usize) -> super::OutboundBudget {
+        let critical_reserved = usize::from(concurrency > 1);
+        super::OutboundBudget {
+            bucket: tokio::sync::Mutex::new(super::Bucket {
+                tokens: burst as f64,
+                updated: Instant::now(),
+            }),
+            rate: rate as f64,
+            burst: burst as f64,
+            in_flight: std::sync::Arc::new(tokio::sync::Semaphore::new(concurrency)),
+            ordinary_in_flight: std::sync::Arc::new(tokio::sync::Semaphore::new(
+                concurrency - critical_reserved,
+            )),
+            critical_reserved,
+            active: std::sync::Arc::new(std::sync::atomic::AtomicUsize::new(0)),
+            waiting: std::sync::atomic::AtomicUsize::new(0),
+            critical_waiting: std::sync::atomic::AtomicUsize::new(0),
+            chat_waiting: std::sync::atomic::AtomicUsize::new(0),
+            chat_next: tokio::sync::Mutex::new(HashMap::new()),
+            chat_interval: Duration::from_millis(1),
+            chat_cache_max: 32,
+        }
+    }
+
+    #[tokio::test]
+    async fn cancelled_admission_does_not_leak_waiting_telemetry() {
+        let budget = super::OutboundBudget::from_env();
+        let blocked = budget
+            .in_flight
+            .clone()
+            .acquire_many_owned(budget.in_flight.available_permits() as u32)
+            .await
+            .unwrap();
+        for _ in 0..10 {
+            assert!(
+                tokio::time::timeout(Duration::from_millis(1), budget.acquire())
+                    .await
+                    .is_err()
+            );
+        }
+        assert_eq!(budget.snapshot(), (0, 0));
+        drop(blocked);
+        let permit = budget.acquire().await;
+        assert_eq!(budget.snapshot(), (1, 0));
+        drop(permit);
+        assert_eq!(budget.snapshot(), (0, 0));
+    }
+
+    #[test]
+    fn per_chat_reservations_are_paced_and_capped() {
+        let mut next = HashMap::new();
+        let now = Instant::now();
+        let interval = Duration::from_secs(3);
+        assert!(reserve_chat(&mut next, -1, now, interval, 2).is_zero());
+        assert!(reserve_chat(&mut next, -1, now, interval, 2) >= interval);
+        assert!(reserve_chat(&mut next, -2, now, interval, 2).is_zero());
+        assert!(reserve_chat(&mut next, -3, now, interval, 2).is_zero());
+        assert!(next.len() <= 2);
+    }
+
+    #[tokio::test]
+    async fn saturation_backlog_and_late_waiter_have_bounded_telemetry() {
+        let budget = std::sync::Arc::new(test_budget(100_000, 100_000, 2));
+        let held = budget
+            .in_flight
+            .clone()
+            .acquire_many_owned(2)
+            .await
+            .unwrap();
+        let mut jobs = Vec::new();
+        for _ in 0..32 {
+            let budget = std::sync::Arc::clone(&budget);
+            jobs.push(tokio::spawn(async move { budget.acquire().await }));
+        }
+        tokio::time::sleep(Duration::from_millis(5)).await;
+        assert_eq!(budget.snapshot(), (0, 32));
+        // A late ordinary caller joins the same bounded ordinary backlog.
+        let late = {
+            let budget = std::sync::Arc::clone(&budget);
+            tokio::spawn(async move { budget.acquire().await })
+        };
+        tokio::time::sleep(Duration::from_millis(2)).await;
+        assert_eq!(budget.snapshot(), (0, 33));
+        drop(held);
+        for job in jobs {
+            drop(job.await.unwrap());
+        }
+        drop(late.await.unwrap());
+        assert_eq!(budget.snapshot(), (0, 0));
+    }
+
+    #[tokio::test]
+    async fn cancellation_of_mixed_backlog_cleans_both_wait_counters() {
+        let budget = std::sync::Arc::new(test_budget(100_000, 100_000, 1));
+        let held = budget.in_flight.clone().acquire_owned().await.unwrap();
+        let mut jobs = Vec::new();
+        for _ in 0..8 {
+            let budget = std::sync::Arc::clone(&budget);
+            jobs.push(tokio::spawn(async move { budget.acquire().await }));
+        }
+        tokio::time::sleep(Duration::from_millis(2)).await;
+        assert_eq!(budget.snapshot(), (0, 8));
+        for job in jobs {
+            job.abort();
+            let _ = job.await;
+        }
+        assert_eq!(budget.snapshot(), (0, 0));
+        drop(held);
+    }
+
+    #[tokio::test]
+    async fn cancelled_critical_waiter_releases_priority_telemetry() {
+        let budget = std::sync::Arc::new(test_budget(100_000, 100_000, 2));
+        let held = budget
+            .in_flight
+            .clone()
+            .acquire_many_owned(2)
+            .await
+            .unwrap();
+        let critical = {
+            let budget = std::sync::Arc::clone(&budget);
+            tokio::spawn(async move { budget.acquire_critical().await })
+        };
+        tokio::time::sleep(Duration::from_millis(2)).await;
+        assert_eq!(budget.snapshot(), (0, 1));
+        assert_eq!(budget.critical_waiting(), 1);
+        critical.abort();
+        let _ = critical.await;
+        assert_eq!(budget.snapshot(), (0, 0));
+        assert_eq!(budget.critical_waiting(), 0);
+        drop(held);
+    }
+
+    #[tokio::test]
+    async fn critical_waiter_takes_the_next_token_ahead_of_ordinary_backlog() {
+        let budget = std::sync::Arc::new(test_budget(20, 1, 4));
+        // Empty the initial burst. The next token is due in roughly 50 ms.
+        drop(budget.acquire().await);
+
+        let (order, mut completed) = tokio::sync::mpsc::unbounded_channel();
+        let mut ordinary = Vec::new();
+        for _ in 0..2 {
+            let budget = std::sync::Arc::clone(&budget);
+            let order = order.clone();
+            ordinary.push(tokio::spawn(async move {
+                let permit = budget.acquire().await;
+                let _ = order.send("ordinary");
+                permit
+            }));
+        }
+        tokio::time::sleep(Duration::from_millis(5)).await;
+        let critical = {
+            let budget = std::sync::Arc::clone(&budget);
+            let order = order.clone();
+            tokio::spawn(async move {
+                let permit = budget.acquire_critical().await;
+                let _ = order.send("critical");
+                permit
+            })
+        };
+
+        assert_eq!(
+            tokio::time::timeout(Duration::from_millis(500), completed.recv())
+                .await
+                .unwrap(),
+            Some("critical")
+        );
+        drop(critical.await.unwrap());
+        for task in ordinary {
+            task.abort();
+            let _ = task.await;
+        }
+        assert_eq!(budget.snapshot(), (0, 0));
+        assert_eq!(budget.critical_waiting(), 0);
+    }
+
+    #[tokio::test]
+    async fn stalled_ordinary_calls_cannot_consume_the_reserved_critical_slot() {
+        let budget = std::sync::Arc::new(test_budget(100_000, 100_000, 4));
+        let mut ordinary = Vec::new();
+        for _ in 0..3 {
+            ordinary.push(budget.acquire().await);
+        }
+        assert_eq!(budget.snapshot(), (3, 0));
+
+        let blocked_ordinary = {
+            let budget = std::sync::Arc::clone(&budget);
+            tokio::spawn(async move { budget.acquire().await })
+        };
+        tokio::time::sleep(Duration::from_millis(2)).await;
+        assert_eq!(budget.snapshot(), (3, 1));
+
+        let critical = tokio::time::timeout(Duration::from_millis(100), budget.acquire_critical())
+            .await
+            .expect("the reserved slot must stay reachable");
+        assert_eq!(budget.snapshot(), (4, 1));
+        drop(critical);
+        blocked_ordinary.abort();
+        let _ = blocked_ordinary.await;
+        drop(ordinary);
+        assert_eq!(budget.snapshot(), (0, 0));
+    }
+
+    #[test]
+    fn peer_pacing_is_independent_for_hot_group_and_quiet_peers() {
+        let mut next = HashMap::new();
+        let now = Instant::now();
+        let interval = Duration::from_millis(20);
+        assert!(reserve_chat(&mut next, -100, now, interval, 32).is_zero());
+        assert!(reserve_chat(&mut next, -200, now, interval, 32).is_zero());
+        assert!(reserve_chat(&mut next, -300, now, interval, 32).is_zero());
+        assert!(reserve_chat(&mut next, -100, now, interval, 32) >= interval);
+        assert!(reserve_chat(&mut next, -200, now, interval, 32) >= interval);
+        assert!(reserve_chat(&mut next, -300, now, interval, 32) >= interval);
+    }
+
+    #[test]
+    #[ignore = "PERF probe; run explicitly with --ignored --nocapture"]
+    fn perf_bounded_chat_cache_churn_json() {
+        let mut next = HashMap::new();
+        let now = Instant::now();
+        let started = Instant::now();
+        for chat in 0..100_000_i64 {
+            let _ = reserve_chat(&mut next, -chat - 1, now, Duration::from_millis(1), 1_000);
+        }
+        let elapsed_us = started.elapsed().as_micros();
+        println!(
+            "{{\"kind\":\"outbound_chat_cache_churn\",\"insertions\":100000,\"capacity\":1000,\"elapsed_us\":{},\"final_len\":{}}}",
+            elapsed_us,
+            next.len()
+        );
+        assert!(next.len() <= 1_000);
+    }
+}
