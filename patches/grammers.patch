+#[test]
+fn test_idle_channel_becomes_dormant_and_retains_its_checkpoint() {
+    reset_time();
+    let mut message_boxes = MessageBoxes::new();
+    message_boxes.set_drop_idle_channels(true);
+    message_boxes.set_state(state(1, 1, 34, 34));
+    let (channel_id, pts) = (12, 34);
+    message_boxes.try_set_channel_state(channel_id, pts);
+
+    advance_time_by(NO_UPDATES_TIMEOUT);
+
+    // The channel becomes dormant rather than queued, so the stream does not stall behind one
+    // request per idle channel, but its checkpoint remains durable.
+    assert_eq!(message_boxes.check_deadlines(), Instant::now());
+    assert_eq!(message_boxes.get_channel_difference(), None);
+    assert_eq!(
+        message_boxes.session_state().channels,
+        vec![ChannelState {
+            id: channel_id,
+            pts
+        }]
+    );
+
+    // The common box keeps the usual behaviour: a gap there is still resolved.
+    assert!(message_boxes.get_difference().is_some());
+    assert!(
+        message_boxes
+            .try_apply_difference(tl::types::updates::DifferenceEmpty { date: 1, seq: 1 }.into())
+            .is_ok()
+    );
+
+    // A late first update is compared against the retained checkpoint. Skipping one pts produces
+    // a recoverable gap instead of silently reseeding the channel at the new remote value.
+    let fresh = pts + 2;
+    assert_eq!(
+        message_boxes.process_updates(channel_updates(channel_id, NO_DATE, NO_SEQ, fresh)),
+        Ok((Vec::new(), Vec::new(), Vec::new()))
+    );
+    advance_time_by(POSSIBLE_GAP_TIMEOUT * 2);
+    message_boxes.check_deadlines();
+    assert_eq!(
+        message_boxes.get_channel_difference(),
+        Some(get_channel_difference(channel_id, pts)),
+        "idle dormancy must recover a later gap from the old checkpoint"
+    );
+}
