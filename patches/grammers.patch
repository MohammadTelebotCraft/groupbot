+use grammers_tl_types as tl;
+use grammers_tl_types::{Deserializable, Serializable};
+
+#[test]
+fn update_ephemeral_callback_query_decodes_with_official_constructor() {
+    assert_eq!(
+        <tl::types::UpdateEphemeralBotCallbackQuery as tl::Identifiable>::CONSTRUCTOR_ID,
+        0x9b380762
+    );
+
+    let update =
+        tl::enums::Update::EphemeralBotCallbackQuery(tl::types::UpdateEphemeralBotCallbackQuery {
+            query_id: 42,
+            user_id: 7,
+            peer: tl::enums::Peer::User(tl::types::PeerUser { user_id: 99 }),
+            msg_id: 3,
+            data: b"settings:privacy".to_vec(),
+            message: tl::enums::EphemeralMessage::Message(tl::types::EphemeralMessage {
+                out: false,
+                id: 3,
+                from_id: tl::enums::Peer::User(tl::types::PeerUser { user_id: 1 }),
+                peer_id: tl::enums::Peer::User(tl::types::PeerUser { user_id: 99 }),
+                receiver_id: 7,
+                top_msg_id: None,
+                date: 0,
+                message: "panel".to_owned(),
+                entities: None,
+                media: None,
+                reply_markup: None,
+                reply_to: None,
+            }),
+        });
+
+    let decoded = tl::enums::Update::from_bytes(&update.to_bytes()).expect("valid update");
+    let tl::enums::Update::EphemeralBotCallbackQuery(decoded) = decoded else {
+        panic!("constructor decoded as the wrong update variant");
+    };
+    assert_eq!(decoded.query_id, 42);
+    assert_eq!(decoded.user_id, 7);
+    assert_eq!(decoded.msg_id, 3);
+    assert_eq!(decoded.data, b"settings:privacy".to_vec());
+}
