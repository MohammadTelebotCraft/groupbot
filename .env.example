# Shared across every shard.
TG_ID=0000000
TG_HASH=00000000000000000000000000000000
SUDO_ID=0
LOG=warn

# Different for every shard, and these two are the whole of it. One bot account per process,
# one database per process: a group has exactly one bot in it, so a shard's database holds only
# that shard's chats and nothing needs to invalidate anything across them.
#
# A shard is a directory. The session files live beside this file, so `systemctl start
# groupbot@alpha` runs /home/ubuntu/shards/alpha with its own .env, groupbot.session and
# cleaner.session, against the one release binary in the repo.
TG_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABASE_URL=postgres://user:password@localhost/groupbot
