# برای همه shard ها یکی است.
TG_ID=0000000
TG_HASH=00000000000000000000000000000000
# اختیاری. اگر sudo ندارید کلا حذفش کنید؛ اگر باشد باید آیدی عددی مثبت باشد.
# SUDO_ID=123456789
# روی production در حد warn بماند. لاگ info برای کل fleet خیلی I/O می خورد.
LOG=warn

# اندازه pool دیتابیس، پیش فرض ۸ و بین ۲ تا ۶۴. عمدا کوچک است چون سرور Postgres بین همه
# shard ها مشترک است. tools/fleet_capacity.py بودجه کل fleet را چک می کند.
DB_POOL=8
# سقف های هر shard. دیتابیسی که از این ها بزرگ تر باشد موقع بالا آمدن رد می شود.
MAX_SHARD_CHATS=50000
MAX_SHARD_SETTINGS_ROWS=5000000
MAX_SHARD_SETTINGS_BYTES=536870912
MAX_SHARD_NOTE_ROWS=5000000
# سقف ردیف شمارنده اعضا و آمار روزانه. اگر نباشند به اندازه MAX_SHARD_CHATS حساب می شوند:
# ۴۰۰ عضو و ۶۴ آمار برای هر گروه، یعنی برای ۵۰ هزار گروه ۲۰ میلیون و ۳.۲ میلیون.
# MAX_SHARD_COUNTER_ROWS=20000000
# MAX_SHARD_TALLY_ROWS=3200000

# چند update همزمان در هر shard. فقط بعد از اندازه گیری تاخیر تلگرام و دیتابیس عوضش کنید.
UPDATE_CONCURRENCY=512
CLEANER_CONCURRENCY=128
# بعد از restart، حداکثر چند گروه همزمان پیام های جا مونده شون گرفته بشه، بدون اینکه پیام های تازه
# منتظر بمونن. خودش از ۴ شروع می کنه و با flood wait کم می کنه. ۱ یعنی مثل قبل، یکی یکی.
CHANNEL_DIFFERENCES=32

# بودجه نوشتن روی تلگرام برای کل اکانت: ارسال، حذف، ویرایش، سنجاق، بن و تغییر دسترسی.
# خواندن محدود نمی شود.
TELEGRAM_ACTIONS_PER_SECOND=25
TELEGRAM_ACTION_BURST=25
TELEGRAM_OUTBOUND_CONCURRENCY=32
# این تعداد از ظرفیت بالا برای حذف و بن کنار گذاشته می شود تا وسط شلوغی پاسخ ها گیر نکنند.
TELEGRAM_CRITICAL_RESERVED_CONCURRENCY=8
# سقف پیام ربات در هر گروه، و اندازه cache آن.
TELEGRAM_GROUP_MESSAGES_PER_MINUTE=20
TELEGRAM_CHAT_RATE_CACHE_MAX=50000

# اختیاری. هر کدام که باشد دکمه اش روی کارت /start می آید. @name یا name یا لینک کامل.
# اگر لازم نیست کلا حذفش کنید؛ مقدار خالی یا خراب موقع بالا آمدن خطا می دهد.
# CHANNEL=@example_channel
# SUPPORT=https://t.me/example_support
# SOURCE=https://example.com/source

# Mini App. اگر MINIAPP_LINK نباشد کل این بخش خاموش است و «پنل» دکمه ای نشان نمی دهد.
# همان لینک t.me/<bot>/<shortname> که BotFather بعد از /newapp می دهد.
# MINIAPP_LINK=https://t.me/example_bot/dashboard
# فقط loopback؛ جلوی آن reverse proxy می نشیند. هر سرویس روی یک سرور port خودش را بگیرد.
MINIAPP_BIND=127.0.0.1:8787
MINIAPP_CONCURRENCY=64

# این دو تا تنها چیزهایی هستند که بین shard ها فرق می کنند: یک ربات و یک دیتابیس برای هر
# process. هر shard یک پوشه است و فایل های session کنار همین فایل می نشینند، پس
# `systemctl start groupbot@alpha` پوشه /home/ubuntu/shards/alpha را اجرا می کند.
TG_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABASE_URL=postgres://user:password@localhost/groupbot
# اختیاری. فایلی با یک chat id در هر خط، از خروجی `tools/shard_route.py --shard <name>`.
# اگر باشد update گروه هایی که مال این shard نیستند دور ریخته می شود.
# SHARD_CHAT_IDS_FILE=/home/ubuntu/shards/alpha/chat_ids.txt

# نظارت ویس. VOICE_PYTHON پایتون virtualenv روی سرور است. کلید خالی یعنی کلید پیش فرض خود
# کتابخانه SpeechRecognition.
VOICE_PYTHON=/home/ubuntu/GroupManagement/groupbot/.venv-voice/bin/python
VOICE_MONITOR_SCRIPT=/home/ubuntu/GroupManagement/groupbot/voice_monitor.py
GOOGLE_SPEECH_RECOGNITION_KEY=
# google یا faster-whisper. دومی فقط وقتی که مدل و وابستگی هایش روی سرور نصب باشد.
VOICE_BACKEND=google
VOICE_WHISPER_MODEL=large-v3
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_WHISPER_BEAM_SIZE=5
VOICE_WHISPER_WINDOW_WORKERS=1
# تعداد worker ها. برای faster-whisper حداکثر ۴، چون هر worker مدل خودش را لود می کند.
VOICE_WORKERS=4
VOICE_QUEUE=128
VOICE_ADMISSION=32

# مدل های تصویری. هر مدل pool خودش را دارد؛ قبل از بالا بردن، حافظه کل process را بسنجید.
NSFW_INFER_SESSIONS=2
NSFW_INFER_THREADS=2
NSFW_SLOTS=2
# shard هایی که روی یک سرورند می توانند از یک نسخه فایل های بزرگ مدل استفاده کنند.
# VISION_FILES=/home/ubuntu/GroupManagement/groupbot/target/release
# برای GPU: `cargo build --release --features cuda` و نسخه GPU از ONNX Runtime.
ORT_USE_CUDA=0
ORT_CUDA_DEVICE=0
# ORT_LIBRARY_PATH=/opt/onnxruntime-gpu/lib/libonnxruntime.so
