# Shared across every shard.
TG_ID=0000000
TG_HASH=00000000000000000000000000000000
# Optional; omit it entirely when no sudo account is configured. A present value must be a
# positive Telegram user id.
# SUDO_ID=123456789
# Keep production at warning level unless diagnosing one shard; info-level MTProto gap logs
# can become significant journald I/O across a large fleet.
LOG=warn

# Postgres pool size, default 8, clamped to 2..64. Deliberately small: the server is shared
# across every shard, so a pool of thirty two at thirty shards asks for 960 backends. For a ten-shard
# 50k-group fleet on PostgreSQL max_connections=100, use DB_POOL=8 to retain connection headroom;
# tools/fleet_capacity.py checks the fleet budget. Raise it only for a shard that measurably needs more.
DB_POOL=8
# Fail fast if this shard is pointed at the whole fleet database. The 500k target is ten
# independent 50k-group shards, not one process with a larger mirror.
MAX_SHARD_CHATS=50000
# Resident settings mirror budget per shard; startup rejects larger databases.
MAX_SHARD_SETTINGS_ROWS=5000000
# Approximate UTF-8 bytes for setting keys and values; this protects the host from a shard full
# of unusually large custom answers even when its row count is within the limit.
MAX_SHARD_SETTINGS_BYTES=536870912
# Durable member-counter rows are kept inside the same shard budget. Existing databases above
# this limit fail startup; new members are rejected transactionally when the budget is full.
MAX_SHARD_COUNTER_ROWS=5000000
# Durable notes use the same transactional per-shard protection. Existing databases above this
# limit fail startup and new notes are rejected without affecting existing notes.
MAX_SHARD_NOTE_ROWS=5000000

# Bounded update admission per shard. Tune only after measuring Telegram/DB latency; values are
# clamped by the process so a bad environment cannot create an unbounded task backlog.
UPDATE_CONCURRENCY=512
CLEANER_CONCURRENCY=128

# Shared account-level write budget. Replies, sends, deletes, edits, pins, kicks, and rights
# changes use this queue; reads are not throttled. The defaults leave headroom below Telegram's
# ordinary bulk-message ceiling and prevent detached jobs from creating an unbounded RPC burst.
TELEGRAM_ACTIONS_PER_SECOND=25
TELEGRAM_ACTION_BURST=25
TELEGRAM_OUTBOUND_CONCURRENCY=32
# Ordinary sends/edits can use 24 of the 32 defaults; eight aggregate slots stay reachable by
# delete/ban/restrict enforcement during an ordinary-response burst. Both classes still share the
# same action-rate bucket, and critical waiters take the next available token.
TELEGRAM_CRITICAL_RESERVED_CONCURRENCY=8
# Telegram also limits bot messages per group. Keep this conservative by default; the per-chat
# pacing metadata is capped independently so 50k quiet groups do not grow the process forever.
TELEGRAM_GROUP_MESSAGES_PER_MINUTE=20
TELEGRAM_CHAT_RATE_CACHE_MAX=50000

# Optional, and each one only draws its button on the /start card when it is set. Takes
# @name, name, or a whole URL. Omit unused variables entirely; a present blank or malformed
# value is a startup error because silently hiding a configured button masks deployment drift.
# CHANNEL=@example_channel
# SUPPORT=https://t.me/example_support
# SOURCE=https://example.com/source

# The Telegram Mini App dashboard. Unset MINIAPP_LINK to leave the whole feature off: no HTTP
# server binds, and «پنل» draws no launch button. Set it to the t.me/<bot>/<shortname> link
# BotFather gives you after /newapp — the panel button appends ?startapp=<chat_id> itself.
# MINIAPP_LINK=https://t.me/example_bot/dashboard
# Loopback only; a reverse proxy is the sole ingress. Each service colocated on one host must
# pick its own port.
MINIAPP_BIND=127.0.0.1:8787
# Bounds total in-flight mini-app requests against the shared settings mirror and DB pool, the
# same way UPDATE_CONCURRENCY bounds the update stream.
MINIAPP_CONCURRENCY=64

# Different for every shard, and these two are the whole of it. One bot account per process,
# one database per process: a group has exactly one bot in it, so a shard's database holds only
# that shard's chats and nothing needs to invalidate anything across them.
#
# A shard is a directory. The session files live beside this file, so `systemctl start
# groupbot@alpha` runs /home/ubuntu/shards/alpha with its own .env, groupbot.session and
# cleaner.session, against the one release binary in the repo.
TG_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DATABASE_URL=postgres://user:password@localhost/groupbot
# Optional fleet ownership enforcement. This must be a complete file with one chat id per line,
# generated from the reviewed `tools/shard_route.py --shard <name>` output. When set, updates for
# any group outside this shard are dropped before state/database admission.
# SHARD_CHAT_IDS_FILE=/home/ubuntu/shards/alpha/chat_ids.txt

# Voice monitoring uses the requested SpeechRecognition bridge. Set this to the virtualenv
# interpreter installed on the server; leave the API key empty to use the library's demo key.
VOICE_PYTHON=/home/ubuntu/GroupManagement/groupbot/.venv-voice/bin/python
VOICE_MONITOR_SCRIPT=/home/ubuntu/GroupManagement/groupbot/voice_monitor.py
GOOGLE_SPEECH_RECOGNITION_KEY=
# `google` preserves the requested SpeechRecognition behavior. Set `faster-whisper` only on a
# worker with the model/dependencies installed; it removes the six external API calls per voice.
VOICE_BACKEND=google
VOICE_WHISPER_MODEL=large-v3
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_WHISPER_BEAM_SIZE=5
VOICE_WHISPER_WINDOW_WORKERS=1
# Persistent ASR workers. Google defaults to four; faster-whisper defaults to one and is capped at
# four because each local worker can load its own model. Raise only after measuring shard RSS.
VOICE_WORKERS=4
VOICE_QUEUE=128
VOICE_ADMISSION=32

# Image inference scaling. Each enabled ONNX model owns a pool, so the fleet-safe default is
# two sessions x two threads per model and two picture slots (peak four cores during passes;
# the pool size, not the thread count, bounds concurrent passes). Scale only after benchmarking
# total process RSS across NSFW, grading, OCR, and optional concept models.
NSFW_INFER_SESSIONS=2
NSFW_INFER_THREADS=2
NSFW_SLOTS=2
# Shards sharing one host can point at a single copy of the large model files
# (vision.onnx, vision_text.onnx and its vocab/merges) instead of one per shard directory.
# VISION_FILES=/home/ubuntu/GroupManagement/groupbot/target/release
# GPU builds use `cargo build --release --features cuda` and an ONNX Runtime GPU library.
ORT_USE_CUDA=0
ORT_CUDA_DEVICE=0
# ORT_LIBRARY_PATH=/opt/onnxruntime-gpu/lib/libonnxruntime.so
